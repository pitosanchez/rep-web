  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . || true",
    "lint:fix": "eslint . --fix",
    "test": "echo 'Tests will be added in Phase 2' && exit 0",
    "type-check": "tsc --noEmit",
    "pipeline": "cd ../rep-data && ts-node -P tsconfig.scripts.json scripts/build_bronx_crosswalk.ts",
