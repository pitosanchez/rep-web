    "csv-stringify": "^6.4.6",
    "maplibre-gl": "^5.17.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
