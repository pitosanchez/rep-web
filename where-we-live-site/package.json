    "pipeline:spatial-join": "cd ../rep-data && ts-node -P tsconfig.scripts.json scripts/spatial_join_tract_to_nta.ts",
    "pipeline:cluster": "cd ../rep-data && ts-node -P tsconfig.scripts.json scripts/build_neighborhood_clusters.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@turf/turf": "^6.5.0",
    "@types/pg": "^8.20.0",
